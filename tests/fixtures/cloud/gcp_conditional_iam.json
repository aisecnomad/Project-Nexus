  {
    "_kind": "iam-policy",
    "_project": "acme-search",
    "version": 3,
    "bindings": [
      {
        "role": "roles/aiplatform.user",
        "members": ["serviceAccount:worker@acme-search.iam.gserviceaccount.com"],
        "condition": {
