{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "local-model", "namespace": "ai"},
      "spec": {
        "template": {
          "spec": {
            "containers": [
              {
                "image": "ollama/ollama:example",
                "env": [{"name": "MODEL_BASE_URL", "value": "omitted"}],
                "resources": {"requests": {"nvidia.com/gpu": 1}}
              }
            ]
          }
        }
      }
    }
  ]
}
