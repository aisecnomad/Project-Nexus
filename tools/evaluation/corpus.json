    {
      "id": "py-aiohttp-client-session-negative",
      "family": "framework-usage",
      "description": "aiohttp.ClientSession with generic loops and subprocess calls is neither MCP nor LLM usage",
      "files": {
        "client.py": "import subprocess\nfrom aiohttp import ClientSession\n\nasync def fetch(url):\n    async with ClientSession() as session:\n        while True:\n            async with session.get(url) as r:\n                if r.status == 200:\n                    return await r.text()\n\ndef run(cmd):\n    return subprocess.Popen(cmd, shell=True)\n"
      },
      "target": {
        "kind": "framework-usage",
        "signature": "protocol.mcp"
      },
      "present": false
    },
    {
      "id": "py-mcp-client-session-bound",
      "family": "framework-usage",
      "description": "An import-bound MCP ClientSession is MCP protocol usage (a client, not an agent)",
      "files": {
        "client.py": "from mcp import ClientSession\nfrom mcp.client.stdio import stdio_client\n\nasync def main(params):\n    async with stdio_client(params) as (r, w):\n        async with ClientSession(r, w) as session:\n            await session.initialize()\n"
      },
      "target": {
        "kind": "framework-usage",
        "signature": "protocol.mcp"
      },
      "present": true,
      "assertions": {
        "max_agent_findings": 0
      }
