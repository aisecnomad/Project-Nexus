{
  "schema": 1,
  "metadata": {
    "name": "Project Nexus code and MCP regression cases",
    "type": "synthetic",
    "provenance": "Handwritten, isolated examples for regression testing; no live repositories, tenants, or independently adjudicated field sample"
  },
  "cases": [
    {
      "id": "py-langgraph-agent",
      "family": "agent",
      "description": "A Python LangGraph import and active StateGraph construction",
      "files": {
        "agent.py": "from langgraph.graph import StateGraph\ngraph = StateGraph(dict)\n"
      },
      "target": {
        "kind": "agent",
        "signature": "framework.langgraph"
      },
      "present": true
    },
    {
      "id": "py-langchain-agent",
      "family": "agent",
      "description": "A Python LangChain import and active agent construction",
      "files": {
        "agent.py": "from langchain.agents import create_agent\nagent = create_agent(model, tools)\n"
      },
      "target": {
        "kind": "agent",
        "signature": "framework.langchain"
      },
      "present": true
    },
    {
      "id": "py-fstring-interpolated-agent",
      "family": "agent",
      "description": "A StateGraph call inside a Python f-string interpolation is executable",
      "files": {
        "agent.py": "from langgraph.graph import StateGraph\nmessage = f'graph: {StateGraph(dict)}'\n"
      },
      "target": {
        "kind": "agent",
        "signature": "framework.langgraph"
      },
      "present": true
    },
