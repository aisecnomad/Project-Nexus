      "description": "An A2A agent card yields one agent finding, not a duplicate project finding",
      "files": {
        ".well-known/agent-card.json": "{\"name\": \"Travel Agent\", \"description\": \"Books travel\", \"url\": \"https://agents.example.com/travel\", \"version\": \"1.0.0\", \"capabilities\": {}, \"defaultInputModes\": [\"text\"], \"defaultOutputModes\": [\"text\"], \"skills\": [{\"id\": \"book\", \"name\": \"Book\", \"description\": \"Books flights\", \"tags\": [\"travel\"]}]}"
      },
      "target": {
        "kind": "agent",
        "signature": "protocol.a2a"
      },
      "present": true,
      "assertions": {
        "max_agent_findings": 1
      }
    },
