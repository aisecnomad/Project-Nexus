    {
      "id": "mcp-stdio-active",
      "family": "mcp-server",
      "description": "A configured MCP stdio server is discoverable",
      "files": {
        ".mcp.json": "{\"mcpServers\":{\"tools\":{\"command\":\"npx\",\"args\":[\"-y\",\"@modelcontextprotocol/server-filesystem\"]}}}\n"
      },
      "target": {
