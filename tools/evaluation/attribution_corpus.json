    {
      "id": "spring-ai-tool-method",
      "family": "agent",
      "description": "Spring AI ChatClient and tool annotation with no LangChain4j import",
      "files": {
        "pom.xml": "<project><dependencies><dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-openai-spring-boot-starter</artifactId></dependency></dependencies></project>\n",
        "src/main/java/example/TicketAssistant.java": "package example;\nimport org.springframework.ai.chat.client.ChatClient;\nimport org.springframework.ai.tool.annotation.Tool;\nclass TicketAssistant {\n    private ChatClient client;\n    @Tool(description = \"Look up a ticket\")\n    public String findTicket(String ticket) { return ticket; }\n    String answer(String question) {\n        return client.prompt().user(question).tools(this).call().content();\n    }\n}\n"
      },
      "target": {
        "kind": "agent",
        "signature": "framework.spring-ai"
      },
      "present": true,
      "assertions": {
        "expected_findings": [
          {
            "kind": "agent",
            "product_signature": "framework.spring-ai"
          }
        ],
        "forbidden_findings": [
          {
            "kind": "agent",
            "product_signature": "framework.langchain4j"
          }
        ],
        "exact_findings": [
          {
            "kind": "agent",
            "product_signatures": [
              "framework.spring-ai"
            ],
            "provider_signatures": []
          }
        ]
      }
    },
    {
      "id": "n8n-compose-workflow",
      "family": "workflow",
      "description": "n8n AI Agent workflow with a Docker Compose service and no Kubernetes resources Known gap: a Docker Compose service is incorrectly credited to Kubernetes agent workloads.",
      "files": {
        "workflows/triage.json": "{\"name\": \"triage\", \"active\": true, \"nodes\": [{\"name\": \"AI Agent\", \"type\": \"@n8n/n8n-nodes-langchain.agent\", \"parameters\": {}}, {\"name\": \"Model\", \"type\": \"@n8n/n8n-nodes-langchain.lmChatOpenAi\", \"parameters\": {}}], \"connections\": {}}\n",
        "docker-compose.yml": "services:\n  n8n:\n    image: docker.n8n.io/n8nio/n8n:1.70.0\n    ports:\n      - \"127.0.0.1:5678:5678\"\n"
      },
      "target": {
        "kind": "workflow",
        "signature": "platform.n8n"
      },
      "present": true,
      "assertions": {
        "expected_findings": [
          {
            "kind": "workflow",
            "product_signature": "platform.n8n",
            "provider_signature": "provider.openai"
          }
        ],
        "forbidden_findings": [
