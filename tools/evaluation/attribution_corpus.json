            "kind": "infra",
            "product_signature": "cloud.kubernetes-agent-workloads"
          }
        ],
        "exact_findings": [
          {
            "kind": "workflow",
            "product_signatures": [
              "platform.n8n"
            ],
            "provider_signatures": [
              "provider.openai"
            ]
          }
        ]
      },
      "known_gap": true
    },
