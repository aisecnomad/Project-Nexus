  "cases": [
    {
      "id": "py-langgraph",
      "family": "agent",
      "description": "Generic LangGraph graph construction in active Python source is framework usage, not an agent",
      "files": {
        "app/graph.py": "from langgraph.graph import StateGraph\nflow = StateGraph(dict)\n"
      },
      "target": {
        "kind": "agent",
        "signature": "framework.langgraph"
      },
      "present": false,
      "assertions": {
        "expected_findings": [
          {
            "kind": "framework-usage",
            "product_signature": "framework.langgraph",
            "capabilities": []
          }
        ],
        "forbidden_findings": [
          {
            "kind": "agent"
          },
          {
            "kind": "agent",
            "product_signature": "framework.langchain"
          }
        ],
        "exact_findings": [
          {
            "kind": "framework-usage",
            "product_signatures": [
              "framework.langgraph"
            ],
            "provider_signatures": []
          }
        ]
      }
    },
