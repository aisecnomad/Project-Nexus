      "id": "spring-ai-tool-method",
      "family": "agent",
      "description": "Spring AI ChatClient and tool annotation with no LangChain4j import; the OpenAI starter attributes the model provider",
      "files": {
        "pom.xml": "<project><dependencies><dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-openai-spring-boot-starter</artifactId></dependency></dependencies></project>\n",
        "src/main/java/example/TicketAssistant.java": "package example;\nimport org.springframework.ai.chat.client.ChatClient;\nimport org.springframework.ai.tool.annotation.Tool;\nclass TicketAssistant {\n    private ChatClient client;\n    @Tool(description = \"Look up a ticket\")\n    public String findTicket(String ticket) { return ticket; }\n    String answer(String question) {\n        return client.prompt().user(question).tools(this).call().content();\n    }\n}\n"
      },
      "target": {
        "kind": "agent",
        "signature": "framework.spring-ai"
      },
      "present": true,
