{
  "schema": 1,
  "metadata": {
    "name": "Project Nexus authored finding attribution regressions",
    "type": "synthetic",
    "provenance": "Handwritten short source samples for known kind, product and provider checks. No credentials, live tenants, independent human labels, or field accuracy claims.",
    "known_gap_policy": {
      "max_count": 1,
      "expires_on": "2026-12-31"
    }
  },
  "cases": [
    {
      "id": "py-langgraph",
      "family": "agent",
      "description": "Generic LangGraph graph construction in active Python source is framework usage, not an agent",
      "files": {
        "app/graph.py": "from langgraph.graph import StateGraph\nflow = StateGraph(dict)\n"
      },
      "target": {
        "kind": "agent",
        "signature": "framework.langgraph"
      },
      "present": false,
      "assertions": {
        "expected_findings": [
          {
            "kind": "framework-usage",
            "product_signature": "framework.langgraph"
          }
        ],
        "forbidden_findings": [
          {
            "kind": "agent"
          },
          {
            "kind": "agent",
            "product_signature": "framework.langchain"
          }
        ],
        "exact_findings": [
          {
            "kind": "framework-usage",
            "product_signatures": [
              "framework.langgraph"
            ],
            "provider_signatures": []
          }
        ]
      }
    },
    {
      "id": "py-langgraph-openai",
      "family": "agent",
      "description": "LangGraph agent with an OpenAI model integration",
      "files": {
        "app/agent.py": "from langchain_openai import ChatOpenAI\nfrom langgraph.prebuilt import create_react_agent\nagent = create_react_agent(ChatOpenAI(model=\"chat-model\"), tools=[])\n"
      },
      "target": {
        "kind": "agent",
        "signature": "framework.langgraph"
      },
      "present": true,
      "assertions": {
        "expected_findings": [
          {
            "kind": "agent",
            "product_signature": "framework.langgraph",
            "provider_signature": "provider.openai"
          }
        ],
        "forbidden_findings": [
          {
            "kind": "agent",
            "provider_signature": "provider.anthropic"
          }
        ],
        "exact_findings": [
          {
            "kind": "agent",
            "product_signatures": [
              "framework.langchain",
              "framework.langgraph"
            ],
            "provider_signatures": [
              "provider.openai"
            ]
          }
        ]
      }
    },
