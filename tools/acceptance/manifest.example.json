{
  "schema": "shadowscan.production-evidence/v1",
  "reviewer": "replace-with-reviewer-reference",
  "reviewed_at": "REPLACE_WITH_REVIEW_TIMESTAMP",
  "policy": {
    "frozen_at": "REPLACE_WITH_POLICY_FREEZE_TIMESTAMP",
    "max_age_hours": 24,
    "min_cases": 300,
    "min_positive_cases": 100,
    "min_negative_cases": 200,
    "min_precision": 0.98,
    "min_recall": 0.95,
    "min_specificity": 0.99,
    "min_precision_lower95": 0.95,
    "min_recall_lower95": 0.95,
    "min_specificity_lower95": 0.95,
    "per_kind": {
      "agent": {
        "min_positive_cases": 100,
        "min_negative_cases": 200,
        "max_false_positives": 0,
        "max_false_negatives": 0,
        "min_precision_lower95": 0.95,
        "min_recall_lower95": 0.95,
        "min_specificity_lower95": 0.95
      }
    }
  },
  "evaluation": {
    "corpus": {"path": "holdout.json", "sha256": "REPLACE_WITH_SHA256"},
    "annotations": {"path": "annotations.json", "sha256": "REPLACE_WITH_SHA256"},
    "report": {"path": "evaluation.json", "sha256": "REPLACE_WITH_SHA256"},
    "population": "replace-with-deployment-population",
    "evaluated_at": "REPLACE_WITH_EVALUATION_TIMESTAMP",
    "holdout_frozen_at": "REPLACE_WITH_HOLDOUT_FREEZE_TIMESTAMP",
    "human_reviewed": false,
    "never_used_for_tuning": false
  },
  "deployments": [
    {
      "connector": "code.filesystem",
      "scope": {"population": "replace-with-deployment-population"}
    }
  ]
}
