  "path_rules": [
    {
      "id": "claude-code",
      "tier": "coding_agent",
      "regex": "(^|/)(claude\\.md|claude\\.local\\.md|\\.claude/.+)$"
    },
    {
      "id": "claude-plugin",
      "tier": "coding_agent",
      "regex": "(^|/)\\.claude-plugin/.+$"
    },
    {
      "id": "agents-md",
      "tier": "coding_agent",
      "regex": "(^|/)agents\\.md$",
      "case_sensitive_name": "AGENTS.md"
    },
    {
      "id": "cursor",
      "tier": "coding_agent",
      "regex": "(^|/)(\\.cursorrules|\\.cursor/(rules|commands|mcp\\.json).*)$"
    },
    {
      "id": "windsurf",
      "tier": "coding_agent",
      "regex": "(^|/)(\\.windsurfrules|\\.windsurf/.+|\\.codeium/.+)$"
    },
    {
      "id": "copilot",
      "tier": "coding_agent",
      "regex": "(^|/)\\.github/(copilot-instructions\\.md|instructions/.+\\.instructions\\.md|prompts/.+\\.prompt\\.md|chatmodes/.+\\.chatmode\\.md|agents/.+\\.(agent\\.)?md)$"
    },
    {
      "id": "gemini-cli",
      "tier": "coding_agent",
      "regex": "(^|/)(gemini\\.md|\\.gemini/.+)$"
    },
    {
      "id": "codex-cli",
      "tier": "coding_agent",
      "regex": "(^|/)\\.codex/.+$"
    },
    {
      "id": "cline-roo-kilo",
      "tier": "coding_agent",
      "regex": "(^|/)(\\.clinerules|\\.clinerules/.+|\\.roo/.+|\\.roomodes|\\.roorules|\\.kilocode/.+)$"
    },
    {
      "id": "continue-dev",
      "tier": "coding_agent",
      "regex": "(^|/)\\.continue/.+$"
    },
    {
      "id": "aider",
      "tier": "coding_agent",
      "regex": "(^|/)\\.aider\\.conf\\.ya?ml$"
    },
    {
      "id": "amazonq-kiro-junie",
      "tier": "coding_agent",
      "regex": "(^|/)(\\.amazonq/.+|\\.kiro/.+|\\.junie/.+|\\.trae/.+)$"
    },
    {
      "id": "agent-skills",
      "tier": "coding_agent",
      "regex": "(^|/)skill\\.md$",
      "case_sensitive_name": "SKILL.md"
    },
    {
      "id": "mcp-config",
      "tier": "mcp",
      "regex": "(^|/)(\\.mcp\\.json|mcp\\.json|mcp[_-]config\\.json|claude_desktop_config\\.json|smithery\\.ya?ml|\\.vscode/mcp\\.json)$"
    },
    {
      "id": "a2a-card",
      "tier": "a2a",
      "regex": "(^|/)(agent-card\\.json|\\.well-known/agent(-card)?\\.json)$"
    },
    {
      "id": "ai-review-bots",
      "tier": "coding_agent",
      "regex": "(^|/)(\\.coderabbit\\.ya?ml|\\.pr_agent\\.toml|greptile\\.json)$"
    },
    {
      "id": "ollama-modelfile",
      "tier": "llm_local",
      "regex": "(^|/)modelfile$",
      "case_sensitive_name": "Modelfile"
    },
    {
      "id": "chatgpt-plugin",
      "tier": "llm_sdk",
      "regex": "(^|/)\\.well-known/ai-plugin\\.json$"
    },
    {
      "id": "mcp-directory-manifest",
      "tier": "mcp",
      "regex": "(^|/)glama\\.json$"
    }
  ],
  "content_markers": [
    {
      "id": "n8n-ai-agent",
      "tier": "agent_framework",
      "exts": [
        ".json"
      ],
      "contains": [
        "n8n-nodes-langchain.agent"
      ]
    },
    {
      "id": "n8n-ai-nodes",
      "tier": "llm_sdk",
      "exts": [
        ".json"
      ],
      "contains": [
        "n8n-nodes-langchain.lmChat",
        "n8n-nodes-langchain.openAi",
        "n8n-nodes-langchain.chainLlm"
      ]
    },
    {
      "id": "flowise-flow",
      "tier": "agent_framework",
      "exts": [
        ".json"
      ],
      "contains": [
        "\"toolAgent\"",
        "\"conversationalAgent\"",
        "\"agentflow\""
      ]
    },
    {
      "id": "langflow-flow",
      "tier": "llm_sdk",
      "exts": [
        ".json"
      ],
      "contains": [
        "\"OpenAIModel\"",
        "\"LanguageModelComponent\"",
        "\"AnthropicModel\""
      ]
    },
    {
      "id": "dify-dsl",
      "tier": "agent_framework",
      "exts": [
        ".yml",
        ".yaml"
      ],
      "regex": "(?m)^kind:\\s*app\\b[\\s\\S]*?mode:\\s*(agent-chat|advanced-chat|workflow)\\b"
    },
    {
      "id": "bedrock-boto3",
      "tier": "llm_sdk",
      "exts": [
        ".py"
      ],
      "regex": "client\\(\\s*['\"]bedrock-(agent-)?runtime['\"]"
    },
    {
      "id": "bedrock-agent-iac",
      "tier": "agent_framework",
      "exts": [
        ".tf",
        ".yaml",
        ".yml",
        ".json",
        ".bicep"
      ],
      "contains": [
        "aws_bedrockagent_agent",
        "AWS::Bedrock::Agent",
        "aws_bedrockagentcore_"
      ]
    },
    {
      "id": "llm-service-iac",
      "tier": "llm_sdk",
      "exts": [
        ".tf",
        ".bicep",
        ".yaml",
        ".yml",
        ".json"
      ],
      "contains": [
        "azurerm_cognitive_deployment",
        "Microsoft.CognitiveServices/accounts/deployments",
        "google_vertex_ai_endpoint",
        "aws_bedrock_model_invocation_logging_configuration",
        "AWS::Bedrock::Guardrail"
      ]
    },
    {
      "id": "ci-ai-agent",
      "tier": "coding_agent",
      "path_regex": "(^|/)\\.github/workflows/.+\\.ya?ml$",
      "contains": [
        "anthropics/claude-code-action",
        "anthropics/claude-code-base-action",
        "google-github-actions/run-gemini-cli",
        "openai/codex-action",
        "All-Hands-AI/openhands"
      ]
    },
    {
      "id": "mcp-protocol-literal",
      "tier": "mcp",
      "exts": [
        ".js",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx",
        ".py",
        ".go",
        ".rs",
        ".java",
        ".kt",
        ".cs"
      ],
      "contains": [
        "\"tools/list\"",
        "'tools/list'",
        "\"notifications/initialized\"",
        "'notifications/initialized'"
      ]
    },
    {
      "id": "mcp-registry-server-json",
      "tier": "mcp",
      "path_regex": "(^|/)server\\.json$",
      "contains": [
        "modelcontextprotocol.io/schemas",
        "io.modelcontextprotocol"
      ]
    }
  ],
