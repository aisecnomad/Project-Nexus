{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "shadowscan.tenant-canary/v1"
    },
    "mode": {
      "enum": [
        "live",
        "replay"
      ]
    },
    "expectation": {
      "enum": [
        "complete",
        "permission-denied"
      ]
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "cloud.aws",
            "saas.slack"
          ]
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "token": {
          "type": "string",
          "pattern": "^\\$\\{[A-Z][A-Z0-9_]*\\}$"
        },
        "account_id": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "team_id": {
          "type": "string",
          "pattern": "^T[A-Z0-9]+$"
        }
      },
      "required": [
        "name"
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "account_id": {
              "type": "string",
              "pattern": "^[0-9]{12}$"
            },
            "regions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "services": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          "required": [
            "account_id",
            "regions",
            "services"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "team_id": {
              "type": "string",
              "pattern": "^T[A-Z0-9]+$"
            }
          },
          "required": [
            "team_id"
          ]
        }
      ]
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "independent_of_scanner": {
          "const": true
        }
      },
      "required": [
        "owner",
        "reviewed_at",
        "source",
        "independent_of_scanner"
      ]
    },
    "controls": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$"
          },
          "record": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 20,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
            }
          },
          "finding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "kind": {
                "enum": [
                  "agent",
                  "framework-usage",
                  "mcp-server",
                  "agent-config",
                  "oauth-grant",
                  "service-identity",
                  "token",
                  "gateway-caller",
                  "workflow",
                  "bot-app",
                  "cloud-resource",
                  "iam-grant",
                  "secret",
                  "infra"
                ]
              },
              "present": {
                "type": "boolean"
              }
            },
            "required": [
              "resource",
              "present"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "present": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "kind"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "kind"
                    ]
                  }
                }
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "record",
          "finding",
          "rationale"
        ]
      }
    }
  },
  "required": [
    "schema",
    "mode",
    "expectation",
    "connector",
    "scope",
    "ground_truth",
    "controls"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped tenant canary configuration",
  "description": "Structural schema. The runner additionally enforces connector/scope equality, explicit AWS regions/services, unique control IDs and positive/negative coverage.",
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live"
          }
        }
      },
      "then": {
        "properties": {
          "connector": {
            "not": {
              "required": [
                "input"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "expectation": {
            "const": "complete"
          },
          "connector": {
            "required": [
              "input"
            ],
            "not": {
              "required": [
                "token"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expectation": {
            "const": "complete"
          }
        }
      },
      "then": {
        "properties": {
          "controls": {
            "minItems": 2
          }
        }
      },
      "else": {
        "properties": {
          "controls": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
