# Normalise line endings so hashes, fixtures and generated evidence compare
# identically on every platform.
* text=auto eol=lf

# Offline fixtures and evaluation corpora mimic other projects' files; keep them
# out of the repository's language statistics and collapse them in diffs.
tests/fixtures/** -text linguist-vendored
tools/evaluation/results/** linguist-generated
tools/evaluation/*_corpus.json linguist-generated
tools/evaluation/corpus.json linguist-generated
# Upstream licence texts are digest-bound byte for byte (.editorconfig and the
# pre-commit whitespace hooks leave them alone too): never convert line endings.
tools/evaluation/independent_licenses/** -text

# Hash-locked requirement files are generated by pip-tools. They stay diffable
# so dependency changes can be reviewed, but are collapsed by default.
requirements*.lock linguist-generated

# Benchmark corpora, labels and stored runs are data, not source (see
# benchmarks/README.md): keep them out of language statistics and collapse
# them in diffs.
benchmarks/*/results/** linguist-generated
benchmarks/*/corpus.json linguist-generated
tools/benchmark/results*/** linguist-generated
tools/benchmark/realworld/results*/** linguist-generated
tools/benchmark/realworld/*.jsonl linguist-generated
tools/benchmark_realworld/results*/** linguist-generated
